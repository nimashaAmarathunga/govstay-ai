datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum WorkStatus {
  WORKING
  RETIRED
}

enum Role {
  PUBLIC_USER
  GOV_EMPLOYEE
  DEPT_ADMIN
  SUPER_ADMIN
}

enum RoomType {
  AC
  NON_AC
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

// ==========================================
// MODELS
// ==========================================

model User {
  id          String      @id @default(uuid())
  name        String
  empId       String?     @unique
  status      WorkStatus  @default(WORKING)
  placeOfWork String?
  position    String?
  username    String      @unique
  password    String
  empIdPhoto  String?
  role        Role        @default(GOV_EMPLOYEE)

  nicNumber          String?
  mobileNumber       String?
  emailAddress       String?
  residentialAddress String?
  preferredDistrict  String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  bookings    Booking[]   @relation("UserBookings")
  sessions    AgentSession[]

  @@map("users")
}

model CircuitBungalow {
  id          String     @id @default(uuid())
  slug        String     @unique
  name        String
  location    String
  latitude    Float?   
  longitude   Float?   
  noOfRooms   Int
  department  String
  gmapLink    String?
  image       String
  description String     @db.Text
  rating      Float      @default(4.8)
  amenities   String[]
  highlights  String[]
  capacity    Int

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  caretaker   Caretaker?
  rooms       Room[]
  bookings    Booking[]

  @@map("circuit_bungalows")
}

model Caretaker {
  id                String          @id @default(uuid())
  name              String
  address           String
  telephoneNo       String
  emailAddress      String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  circuitBungalowId String          @unique
  circuitBungalow   CircuitBungalow @relation(fields: [circuitBungalowId], references: [id], onDelete: Cascade)

  @@map("caretakers")
}

model Room {
  id                String          @id @default(uuid())
  roomNumber        String
  roomType          RoomType        @default(NON_AC)
  items             String[]
  noOfBeds          Int
  capacity          Int?
  bed_count         Int?
  price             Float

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  circuitBungalowId String
  circuitBungalow   CircuitBungalow @relation(fields: [circuitBungalowId], references: [id], onDelete: Cascade)

  bookings          Booking[]

  @@map("rooms")
}

model Booking {
  id                String          @id @default(uuid())
  bookingId         String          @unique @default(cuid())

  userId            String
  user              User            @relation("UserBookings", fields: [userId], references: [id], onDelete: Cascade)

  circuitBungalowId String
  circuitBungalow   CircuitBungalow @relation(fields: [circuitBungalowId], references: [id], onDelete: Cascade)

  roomId            String
  room              Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)

  fromDate          DateTime
  toDate            DateTime
  status            BookingStatus   @default(PENDING)
  totalCost         Float?
  paymentSlipUrl    String?

  approvalReason    String?         @db.Text
  confidenceScore   Float?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("bookings")
}

model AgentSession {
  id            String   @id @default(uuid())
  sessionId     String   @unique

  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  sessionMemory Json
  auditTrace    Json?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("agent_sessions")
}